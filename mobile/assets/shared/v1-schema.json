{
  "GET /api/v1/puzzle": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "num": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "goldRows": {
        "minItems": 4,
        "maxItems": 5,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "startLetters": {
        "type": "string"
      },
      "startTiles": {
        "minItems": 16,
        "maxItems": 25,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "letter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          },
          "required": [
            "id",
            "letter"
          ],
          "additionalProperties": false
        }
      },
      "minSwaps": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "num",
      "goldRows",
      "startLetters",
      "startTiles",
      "minSwaps"
    ],
    "additionalProperties": false
  },
  "GET /api/v1/app-config": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "minSupportedVersion": {
        "type": "string"
      },
      "whatsNew": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "body"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "flags": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "required": [
      "minSupportedVersion",
      "whatsNew",
      "flags"
    ],
    "additionalProperties": false
  },
  "GET /api/v1/results": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "const": true
      },
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "num": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "type": "string",
              "enum": [
                "classic",
                "hard"
              ]
            },
            "moves": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bonus": {
              "type": "boolean"
            },
            "revealed": {
              "type": "boolean"
            },
            "verified": {
              "type": "boolean"
            },
            "timeMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "completedAt": {
              "type": "number"
            }
          },
          "required": [
            "num",
            "mode",
            "moves",
            "bonus",
            "revealed",
            "verified",
            "timeMs",
            "completedAt"
          ],
          "additionalProperties": false
        }
      },
      "streaks": {
        "type": "object",
        "properties": {
          "classic": {
            "type": "object",
            "properties": {
              "current": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastWon": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "current",
              "max",
              "lastWon"
            ],
            "additionalProperties": false
          },
          "hard": {
            "type": "object",
            "properties": {
              "current": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "lastWon": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "current",
              "max",
              "lastWon"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "classic",
          "hard"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "ok",
      "results",
      "streaks"
    ],
    "additionalProperties": false
  },
  "DELETE /api/v1/account": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "const": true
      },
      "status": {
        "type": "string",
        "const": "pending_deletion"
      },
      "permanentAt": {
        "type": "string"
      },
      "alreadyPending": {
        "type": "boolean"
      }
    },
    "required": [
      "ok",
      "status",
      "permanentAt",
      "alreadyPending"
    ],
    "additionalProperties": false
  }
}

# Daily social post — copy to .env and fill in. Never commit secrets.

# Optional override; defaults to https://tesserapuzzle.com/
PUZZLE_URL=https://tesserapuzzle.com/

# X (Twitter) — OAuth 1.0a user context
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Reddit — "script" app owned by u/coopstar230
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=coopstar230
REDDIT_PASSWORD=

# Facebook Page (Graph API)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Bluesky — handle + App Password (Settings → Privacy and security → App Passwords)
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Flags
DRY_RUN=0
# ONLY=x,reddit,facebook

# ─────────────────────────────────────────────────────────────────────
# Mobile backend (Phase B). Set in the Vercel project env, not here.
# ─────────────────────────────────────────────────────────────────────

# GET /api/v1/app-config
MIN_SUPPORTED_VERSION=1.0.0
# WHATS_NEW={"id":"v1_1","title":"...","body":"..."}
# APP_FLAGS={"interstitial":false}

# Deep links (/.well-known/*)
APPLE_APP_ID=            # <10-char Team ID>.com.tesserapuzzle.app
ANDROID_CERT_SHA256=     # comma-separated SHA-256 signing-cert fingerprints

# RevenueCat webhook (POST /api/v1/billing/revenuecat)
REVENUECAT_WEBHOOK_SECRET=   # Authorization header value set in the RC dashboard
REVENUECAT_API_KEY=          # RC secret REST key, server-side only

# Account-deletion confirmation email reuses LOOPS_API_KEY; author a
# Loops transactional event named "account_deletion_scheduled" with a
# {{permanent_at}} data variable.
